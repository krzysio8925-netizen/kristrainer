rules_version = '2';

// UWAGA: kalkulator Kris Trainer korzysta z tego samego projektu Firebase (gabitrainer) co aplikacja GabiTrainer.
// Reguły są wspólne dla całego projektu – w konsoli Firebase zawsze wklejaj CAŁY ten plik.
// Wklejenie samego bloku isKris() odcięłoby aplikację i panel GabiTrainer od bazy.

// GabiTrainer database rules.
// A client reads and writes only their own data; the trainer (one e-mail address, verified) sees everyone.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isTrainer() {
      return signedIn()
        && request.auth.token.email == 'g.rajecka@o2.pl'
        && request.auth.token.email_verified == true;
    }
    function isClient(uid) { return signedIn() && request.auth.uid == uid; }
    // Fields on the client document that only the trainer may set.
    function clientMayChange() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['hasPlan', 'trainerReadAt', 'lastReportReviewed']);
    }

    match /clients/{uid} {
      allow read: if isClient(uid) || isTrainer();
      allow create: if isClient(uid);
      allow update: if isTrainer() || (isClient(uid) && clientMayChange());

      // Training plan and meal plan: written by the trainer, read by the client.
      match /plan/{doc} {
        allow read: if isClient(uid) || isTrainer();
        allow write: if isTrainer();
      }

      // Weekly reports: the client creates them, the trainer adds feedback.
      match /reports/{id} {
        allow read: if isClient(uid) || isTrainer();
        allow create: if isClient(uid);
        allow update: if isTrainer();
      }

      // Body photos (compressed images) attached to reports.
      match /photos/{id} {
        allow read: if isClient(uid) || isTrainer();
        allow create: if isClient(uid) && request.resource.data.data.size() < 900000;
      }

      // Logged workouts.
      match /workouts/{id} {
        allow read: if isClient(uid) || isTrainer();
        allow create: if isClient(uid);
      }

      // Chat between the client and the trainer.
      match /messages/{id} {
        allow read: if isClient(uid) || isTrainer();
        allow create: if (isClient(uid) && request.resource.data.from == 'client')
                      || (isTrainer() && request.resource.data.from == 'trainer');
      }
    }

    // The trainer's own tasks and calendar.
    match /tasks/{id} { allow read, write: if isTrainer(); }
    match /events/{id} { allow read, write: if isTrainer(); }

    // Kris Trainer – kalkulator diety (folder kalkulator/). Osobna kolekcja, dostęp ma tylko jedno konto.
    function isKris() {
      return signedIn()
        && request.auth.token.email == 'krzysio8925@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /kris_clients/{id} {
      allow read, write: if isKris();
      match /versions/{v} { allow read, write: if isKris(); }
    }
  }
}
